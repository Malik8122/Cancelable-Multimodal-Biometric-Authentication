# Production environment variables for the Render deployment of this
# backend. For LOCAL DEVELOPMENT, use the repository root's `.env.example`
# instead (`cp .env.example .env` from the repo root) - `backend/config.py`'s
# `Settings` reads a `.env` file relative to the process's working directory
# (the repo root, since the app is always started as
# `uvicorn backend.main:app` from there - see README.md), not relative to
# this file, so a `.env` copied here would NOT be picked up.
#
# On Render, set these as real environment variables in the service's
# dashboard (or in backend/render.yaml's `envVars`) - never as a committed
# `.env` file. This file exists purely as documentation of what to set.

# Root secret every cancelable template's HKDF key is derived from - no
# working default; the server refuses to start without one. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Set this as a real, private Render environment variable (or a Render
# "secret" env var) - never commit the real value anywhere.
MASTER_SECRET=replace-with-a-real-secret-you-generated-yourself

# Bare filesystem path to the SQLite database file, matching Render's
# persistent disk mount path configured in backend/render.yaml. Takes
# priority over DATABASE_URL when set (see backend/config.py::Settings.database_path).
DATABASE_PATH=/var/data/biometric.db

# "production" disables interactive Swagger/ReDoc/raw OpenAPI JSON
# (see backend/main.py::_is_production) - it changes nothing about
# authentication or model behavior, only whether API documentation pages
# are servable.
ENV=production

# The deployed Vercel frontend's exact origin (scheme + host, no trailing
# slash) - the only origin allowed to call this API from a browser. Never
# "*"; this API handles biometric templates. See
# backend/main.py::_resolve_cors_origins.
CORS_ORIGIN=https://your-app.vercel.app
