# Copy this file to `.env` (which is gitignored) and fill in real values.
# Never commit a real .env - MASTER_SECRET protects every enrolled user's
# biometric templates.

# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MASTER_SECRET=replace-with-a-real-secret-you-generated-yourself

# Optional - defaults shown. See backend/config.py for the full list and
# what each one does.
# DATABASE_URL=sqlite:///./biometric.db
# APPLICATION_ID=capstone-demo
# FACE_MODEL_PATH=models/face/saved/face_embedder.pt
# VOICE_MODEL_PATH=models/voice/saved/voice_embedder.pt
# TEMPLATE_BITS=256
# MATCH_THRESHOLD=0.9
# Face: estimated cosine >= threshold. Voice: estimated Euclidean distance <= threshold.
# FACE_COSINE_THRESHOLD=0.80
# VOICE_EUCLIDEAN_THRESHOLD=0.75
# Template sets created per enrollment (1 ACTIVE, the rest STANDBY).
# TEMPLATE_POOL_SIZE=4
# Building list (context only). Unset = config/buildings.json.
# BUILDINGS_CONFIG_PATH=config/buildings.json

# Local development only: include per-modality scores in API responses, so the
# result page shows Face / Voice Similarity. Never enable in production.
# DEBUG_SCORES=true

# Comma-separated origins the Phase 3A dashboard (Vite dev server, by
# default http://localhost:5173) is allowed to call this API from. Read
# directly by backend/main.py, not via Settings - see that file's
# _resolve_cors_origins() docstring for why. Never set this to "*".
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security response to a SUSPICIOUS authentication attempt (repeated high-quality mismatches, never a single failed
# login): promote the next STANDBY template set for every enrolled modality (T1 -> T2). Off by default (each
# escalation spends one of the 3 standby sets). Demo: true
TEMPLATE_ROTATION_ON_FAILED_AUTH=false
# Failure handling: a usable capture that fails verification is retried MAX_MODALITY_RETRIES times; the next
# consecutive mismatch (within the window) is a suspicious attempt and triggers the security response above.
# Capture/quality failures never count. Security policy values - review before deployment.
MAX_MODALITY_RETRIES=2
SUSPICIOUS_MISMATCH_WINDOW_SECONDS=900
# Unusable captures never rotate templates; after this many in a row, attempts pause for the cooldown (0 = off).
MAX_CONSECUTIVE_CAPTURE_FAILURES=5
CAPTURE_FAILURE_COOLDOWN_SECONDS=60
# Voice capture-quality gate (measured defaults - docs/VOICE_MODEL.md). A failing recording asks for a re-recording.
VOICE_MIN_SPEECH_SECONDS=1.5
VOICE_MIN_ESTIMATED_SNR_DB=10
VOICE_MAX_CLIPPING_FRACTION=0.01
# Dynamic hand gesture - the Z (docs/HAND_GESTURE_MODALITY.md). The DTW threshold is a DEVELOPMENT DEFAULT from a
# SYNTHETIC calibration; re-calibrate on real recordings with evaluation/hand_gesture_evaluation.py, then set the
# source to EXPERIMENTALLY_CALIBRATED.
# HAND_GESTURE_DTW_THRESHOLD=0.216
# HAND_GESTURE_THRESHOLD_SOURCE=DEVELOPMENT_DEFAULT
# HAND_GESTURE_ENROLLMENT_ATTEMPTS=3
# HAND_GESTURE_AGGREGATION=median
# HAND_GESTURE_DTW_BAND=0.2
# HAND_GESTURE_ROTATION_TOLERANCE_DEG=12
# Editing an existing display name (testing aid). Unset = allowed outside production, refused in production.
# ALLOW_PROFILE_EDITING=true
